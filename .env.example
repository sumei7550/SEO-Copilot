# Local development uses the deterministic Mock Provider by default.
VITE_AI_PROVIDER=mock

# Alpha builds should set VITE_AI_PROVIDER=real and provide the Backend URL.
VITE_SEO_COPILOT_BACKEND_URL=http://localhost:8787

# Backend environment. Copy this file to .env and set the API key locally.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
PORT=8787

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "../server-dist",
    "rootDir": ".",
    "noEmit": false
  },
  "include": ["./**/*.ts"],
  "exclude": ["./**/*.test.ts"]
}
